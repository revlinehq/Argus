# ── Shared ──────────────────────────────────────────────
# Set by `npx convex dev` (written to .env.local automatically)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Clerk (apps/web/.env.local) ─────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Convex deployment env (set with `npx convex env set`) ─
# CLERK_JWT_ISSUER_DOMAIN=https://<your-app>.clerk.accounts.dev
# WORKER_SECRET=<long random string, same as below>

# ── Worker (apps/worker/.env) ───────────────────────────
# CONVEX_URL=<same as NEXT_PUBLIC_CONVEX_URL>
# WORKER_SECRET=<same as Convex env>
# WORKER_PORT=8788
# PUBLIC_WS_URL=ws://localhost:8788
# BUFFER_SECONDS=300
